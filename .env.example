# Copy to .env and adjust. Every value has a sensible development default.

# --- Core ---------------------------------------------------------------
# Public URL people open in the browser. Used to build links in emails.
# In development this is the Vite dev server (which proxies /api to the API).
APP_URL=http://localhost:5173
PORT=3001
DATABASE_URL=postgres://toretto:toretto@localhost:5432/toretto

# Only this address may create the first admin account on the /setup page.
# Required in production so nobody else can claim a fresh deployment.
ADMIN_EMAIL=

# --- Email --------------------------------------------------------------
# console  = print emails to the server log and show them at /dev/mailbox (dev only)
# smtp     = any SMTP relay (SendGrid, Postmark, Mailgun, Office 365, Mailpit...)
# postmark = Postmark HTTP API        sendgrid = SendGrid HTTP API
EMAIL_TRANSPORT=console
EMAIL_FROM="Toretto Scheduling <scheduling@example.com>"
# SMTP_URL=smtp://username:password@smtp.example.com:587
# POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=outbound
# SENDGRID_API_KEY=

# --- Background worker --------------------------------------------------
# The worker sends queued emails and shift reminders. By default it runs
# inside the web process; set to false if you run `npm run worker` separately.
RUN_WORKER=true

# Number of reverse proxies in front of the app (1 on Render/Railway/Fly/Heroku;
# automatic on Vercel) so rate limiting sees the real client IP.
TRUST_PROXY=0

# --- Vercel ---------------------------------------------------------------
# Authorizes Vercel Cron's daily call to /api/cron (reminders, email retries).
# Any random string of 16+ characters, e.g. `openssl rand -hex 32`.
# CRON_SECRET=
